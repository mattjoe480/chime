{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm dev",
      "type": "shell",
      "command": "pnpm", // note: full path to the cargo
      "args": [
          "run",
          "dev"
      ],
      "problemMatcher": ["$tsc"],
      "group": {
          "kind": "build",
          "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/app/apps/web"
      }
    },

    
  ]
}
